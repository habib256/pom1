;============================================================================
; sid_notes12.inc -- octave-7 SID frequency table (C7..B7), 12 notes
;============================================================================
; Generated by tools/build_sid_notes.py --top-octave — do not edit by hand.
; sid_player.asm (default build) plays note n as
;   value = top[n mod 12] >> s, rounded on the last bit shifted out,
;   s = 7 - n div 12
; Same formula as sid_notes.inc for octave 7; below it, 5 of the 84 derived
; values differ from the directly rounded ones by 1 LSB (< 0.1 cent).
; Worst pitch error against equal temperament, all 96 notes: 1.58 cents
; (the 96-note table: 1.58 cents).
;============================================================================

SID_TOP_0 = $861E    ; C7
SID_TOP_1 = $8E18    ; CS7
SID_TOP_2 = $968B    ; D7
SID_TOP_3 = $9F7F    ; DS7
SID_TOP_4 = $A8FB    ; E7
SID_TOP_5 = $B307    ; F7
SID_TOP_6 = $BDAC    ; FS7
SID_TOP_7 = $C8F4    ; G7
SID_TOP_8 = $D4E7    ; GS7
SID_TOP_9 = $E18F    ; A7
SID_TOP_10 = $EEF9    ; AS7
SID_TOP_11 = $FD2F    ; B7

sid_top_lo:
        .lobytes SID_TOP_0, SID_TOP_1, SID_TOP_2, SID_TOP_3, SID_TOP_4, SID_TOP_5, SID_TOP_6, SID_TOP_7, SID_TOP_8, SID_TOP_9, SID_TOP_10, SID_TOP_11
sid_top_hi:
        .hibytes SID_TOP_0, SID_TOP_1, SID_TOP_2, SID_TOP_3, SID_TOP_4, SID_TOP_5, SID_TOP_6, SID_TOP_7, SID_TOP_8, SID_TOP_9, SID_TOP_10, SID_TOP_11

; Rounding never carries: after a shift of k (1..7) the low byte and the bit
; shifted out are never all ones, so `INC lo` alone completes the round.
.repeat 12, N
.repeat 7, K
.assert ((.ident(.sprintf("SID_TOP_%d", N)) >> K) .bitand $1FF) <> $1FF, error, "sid_notes12: rounding would carry into the high byte"
.endrepeat
.endrepeat
