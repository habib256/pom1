; =============================================
; hgr_scanline.inc - HGR scanline base-address tables (384 bytes)
; =============================================
; Split out of hgr_tables.inc. hgr_lo[192] / hgr_hi[192] = base address of
; scanline y in the GEN2 HGR framebuffer (Apple II interleaved layout):
;   addr[y] = $2000 + (y%8)*$0400 + ((y/8)%8)*$80 + (y/64)*$28
; Generated by .repeat from that formula (byte-identical to the hand-typed
; tables it replaced). Include-guarded.
;
; The tables are ordinary data in the current segment, so they are writable
; when the program runs from RAM -- hgr_flip.asm relies on that (it rewrites
; hgr_hi in place to switch the draw page).
;
; A program short of file space can build the same tables at start instead:
; hgr_scanline_ram.asm (384 B less in the file, ~50 B of code). Include one
; or the other, never both.
; =============================================
.ifndef _HGR_SCANLINE_INC_LOADED_
_HGR_SCANLINE_INC_LOADED_ = 1

.ifdef _HGR_SCANLINE_RAM_LOADED_
.error "hgr_scanline.inc: hgr_scanline_ram.asm already defines hgr_lo/hgr_hi"
.endif

; --- hgr_lo[192]: scanline base address low byte ---
hgr_lo:
        .repeat 192, row
        .byte <($2000 + (row .mod 8) * $0400 + ((row / 8) .mod 8) * $80 + (row / 64) * $28)
        .endrepeat

; --- hgr_hi[192]: scanline base address high byte ---
hgr_hi:
        .repeat 192, row
        .byte >($2000 + (row .mod 8) * $0400 + ((row / 8) .mod 8) * $80 + (row / 64) * $28)
        .endrepeat

.endif  ; _HGR_SCANLINE_INC_LOADED_
